# Copie este arquivo para ".env" e preencha com suas chaves.
# Nenhuma dessas chaves é secreta o suficiente para ficar fora do
# front-end (são as mesmas usadas pelo SDK do Firebase no navegador),
# mas ainda assim não commite seu .env real em repositórios públicos
# sem revisar as regras de segurança do Firestore.

# --- TMDB (https://www.themoviedb.org/settings/api) ---
VITE_TMDB_API_KEY=

# --- Firebase (https://console.firebase.google.com) ---
VITE_FIREBASE_API_KEY= 
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
